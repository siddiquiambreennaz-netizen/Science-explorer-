npm ls react react-dom# Server-side Gemini API key from Google AI Studio (never use a VITE_ prefix)
GEMINI_API_KEY=put_your_gemini_api_key_here
# Optional preferred Gemini model. Uses current stable IDs; automatically tries gemini-3.8-flash if Flash-Lite is unavailable.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional ElevenLabs TTS key, separate from your Gemini key.
# Add this to enable generated speech for English, Urdu script, Roman Urdu, and Sindhi script.
ELEVENLABS_API_KEY=put_your_elevenlabs_api_key_here
ELEVENLABS_MODEL=eleven_v3
# Voice IDs are optional: the app first tries to select a matching voice from your available ElevenLabs voices.
# For manual overrides, copy voice IDs from ElevenLabs > My Voices > ... > Copy voice ID.
# ELEVENLABS_VOICE_ID_EN=your_english_voice_id
# ELEVENLABS_VOICE_ID_UR=your_urdu_voice_id
# ELEVENLABS_VOICE_ID_ROMAN=your_pakistani_urdu_voice_id
# ELEVENLABS_VOICE_ID_SD=your_sindhi_voice_id

# Keep your existing Supabase variables in your local .env file.
